# Google Cloud & Vertex AI / Gemini Live Configuration
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
FIRESTORE_DATABASE=(default)

# Gemini Live Native Audio Model (Vertex AI / Gemini Enterprise)
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-preview-04-09

# Local Development Toggle (set to true to use local JSON mock DB instead of live Firestore)
USE_MOCK_DB=true
MOCK_DB_PATH=data/mock_db.json

# Store Identity
STORE_NAME=Sharma Kirana & General Store
STORE_UPI_ID=sharmakirana@okaxis

# Optional Twilio WhatsApp Sandbox Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
